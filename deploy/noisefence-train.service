[Unit]
Description=Export human feedback and train a NoiseFence model candidate (never auto-activate)

[Service]
Type=oneshot
User=noisefence
Group=noisefence
WorkingDirectory=/var/lib/noisefence/models
StateDirectory=noisefence/models
StateDirectoryMode=0700
RuntimeDirectory=noisefence-learning
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=no
UMask=0077
EnvironmentFile=-/etc/noisefence/training.env
ExecStart=/usr/bin/python3 /opt/noisefence/current/deploy/train-feedback.py
TimeoutStartSec=35min
MemoryMax=4G
OOMScoreAdjust=500
CPUQuota=200%
Nice=10
PrivateNetwork=true
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/noisefence
ProtectHome=true
PrivateTmp=true
