# Configure the real hostname and its DNS before starting Caddy.
noisefence.example.org {
    encode zstd gzip
    @cluster path /api/v1/cluster/*
    request_body @cluster {
        max_size 4MB
    }
    @directory path /api/v1/admin/identity/prepare
    request_body @directory {
        max_size 17825792
    }
    @ad_export path /api/v1/admin/identity/sync/active_directory
    request_body @ad_export {
        max_size 25165824
    }
    @console not path /api/v1/cluster/* /api/v1/admin/identity/prepare /api/v1/admin/identity/sync/active_directory
    request_body @console {
        max_size 128KB
    }
    header Strict-Transport-Security "max-age=31536000"
    reverse_proxy 127.0.0.1:8080
}
