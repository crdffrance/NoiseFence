[Unit]
Description=NoiseFence recovered PostgreSQL console checkpoint
After=network-online.target noisefence-console.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/libexec/noisefence-ha/standby.py push --recovered-console
UMask=0077
TimeoutStartSec=360
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/noisefence-standby
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=512M
