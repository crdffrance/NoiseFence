#include <tunables/global>
profile noisefence-console {
  #include <abstractions/base>
  #include <abstractions/nameservice>
  /etc/ld.so.cache r,
  /etc/ld.so.preload r,
  /usr/lib/** mr,
  /lib/** mr,
  /usr/share/** r,
  /etc/localtime r,
  /etc/timezone r,
  /etc/machine-id r,
  /sys/devices/system/cpu/** r,
  /sys/fs/cgroup/** r,
  owner /proc/** r,
  signal (receive) peer=unconfined,
  ptrace (readby, tracedby) peer=unconfined,
  signal (send, receive) peer=noisefence-console,
  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  network netlink raw,
  network unix,
  /opt/noisefence/** mr,
  /opt/noisefence/{current,releases/*}/noisefence ix,
  /var/lib/noisefence-standby/active/ r,
  /var/lib/noisefence-standby/active/** r,
  owner /var/lib/noisefence-standby/active/data/** rwkl,
  owner /var/lib/noisefence-standby/active/data/ rw,
  /run/clamav/clamd.ctl rw,
  /run/noisefence-signatures/clamd.ctl rw,
  /run/noisefence-vision/worker.sock rw,
  owner /tmp/** rwk,
  owner /var/tmp/** rwk,
}
