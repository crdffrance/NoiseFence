[Unit]
Description=Process calibration jobs on the recovered NoiseFence console
After=noisefence-console.service
ConditionPathExists=/var/lib/noisefence-standby/promoted.json
ConditionPathExists=!/var/lib/noisefence-recovery-install/hold.json
ConditionPathExists=!/var/lib/noisefence-standby/fenced.json

[Service]
Type=oneshot
User=noisefence
Group=noisefence
RuntimeDirectory=noisefence-recovered-quality
RuntimeDirectoryMode=0700
UMask=0077
EnvironmentFile=-/etc/noisefence/training.env
ExecStart=/usr/bin/python3 /opt/noisefence/current/deploy/recovered-job.py quality
TimeoutStartSec=35min
MemoryMax=1G
OOMScoreAdjust=500
CPUQuota=100%
Nice=10
PrivateNetwork=true
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/noisefence-standby/active/data
ProtectHome=true
PrivateTmp=true
