    "patch_from_baseline": "--- baseline-worker.py\n+++ combined-prototype.py\n@@ -145,8 +145,25 @@\n     return limits, decoded\n \n \n+def _normalized_page(image, directory):\n+    from PIL import Image, ImageOps\n+    image = ImageOps.exif_transpose(image)\n+    # Flatten transparency on white before either decoder sees the page.\n+    rgba = image.convert(\"RGBA\")\n+    rgb = Image.new(\"RGB\", rgba.size, \"white\")\n+    rgb.paste(rgba, mask=rgba.getchannel(\"A\"))\n+    # Internal lossless RGB avoids a compress/decompress cycle on ordinary pages.\n+    # Eight million pixels occupy <24 MiB in PPM, below the 32 MiB file limit.\n+    # Larger allowed images retain PNG, so this optimization cannot newly exceed\n+    # that limit. One reused path also bounds disk use across mixed page sizes.\n+    normalized = Path(directory) / \"page.image\"\n+    format_name = \"PPM\" if rgb.width * rgb.height <= 8_000_000 else \"PNG\"\n+    rgb.save(normalized, format=format_name)\n+    return normalized\n+\n+\n def analyze(req, directory):\n-    from PIL import Image, ImageOps\n+    from PIL import Image\n     limits, parts = validate_request(req)\n     Image.MAX_IMAGE_PIXELS = limits[\"max_pixels\"]\n     warnings.simplefilter(\"error\", Image.DecompressionBombWarning)\n@@ -164,13 +181,7 @@\n             raise Limited(\"page_limit\")\n         if image.width * image.height > limits[\"max_pixels\"] or min(image.size) <= 0:\n             raise Limited(\"pixel_limit\")\n-        normalized = Path(directory) / \"page.png\"\n-        image = ImageOps.exif_transpose(image)\n-        # Flatten transparency on white; never feed ImageMagick the original format.\n-        rgba = image.convert(\"RGBA\")\n-        rgb = Image.new(\"RGB\", rgba.size, \"white\")\n-        rgb.paste(rgba, mask=rgba.getchannel(\"A\"))\n-        rgb.save(normalized)\n+        normalized = _normalized_page(image, directory)\n         xml = command([\"zbarimg\", \"--quiet\", \"--xml\", \"--nodisplay\", str(normalized)],\n                       acceptable=(0, 4))\n         codes = []\n@@ -214,9 +225,11 @@\n                     if len(response[\"pages\"]) >= limits[\"max_pages\"]:\n                         raise Limited(\"page_limit\")\n                     prefix = Path(directory) / \"pdf-page\"\n+                    # Default RGB PPM has the same raster without PNG encoding.\n+                    # scale-to 2400 bounds it below 18 MiB, including the header.\n                     command([\"pdftoppm\", \"-f\", str(number), \"-l\", str(number), \"-singlefile\",\n-                             \"-scale-to\", \"2400\", \"-png\", str(pdf), str(prefix)])\n-                    with Image.open(str(prefix) + \".png\") as img:\n+                             \"-scale-to\", \"2400\", str(pdf), str(prefix)])\n+                    with Image.open(str(prefix) + \".ppm\") as img:\n                         page(img, index, number - 1)\n                 if count > limits[\"max_pages\"]:\n                     raise Limited(\"page_limit\")\n"
